<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF 仅支持 Windows 目标框架 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AbatementTrainer</AssemblyName>
    <RootNamespace>AbatementTrainer.App</RootNamespace>
    <!-- 现场常运行于无独显环境,平台锁定 x64 以匹配 SharpDX 原生依赖 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbatementTrainer.Core\AbatementTrainer.Core.csproj" />
  </ItemGroup>

  <!-- 内容(模型 + 清单)随程序部署到输出目录的 content/ -->
  <ItemGroup>
    <None Include="..\..\content\**\*.*" Link="content\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
