<Window x:Class="AbatementTrainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:AbatementTrainer.App"
        xmlns:vm="clr-namespace:AbatementTrainer.App.ViewModels"
        xmlns:svc="clr-namespace:AbatementTrainer.App.Services"
        Title="{Binding Loc[AppTitle]}"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <local:RequiredToBrushConverter x:Key="ReqBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────── 顶部工具栏 ───────── -->
        <DockPanel Grid.Row="0" Background="#1E2A38" LastChildFill="False">
            <TextBlock Text="{Binding Loc[AppTitle]}" Foreground="White"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                       Margin="12,8" DockPanel.Dock="Left" />

            <Button Content="{Binding Loc[Language]}" Command="{Binding ToggleLanguageCommand}"
                    Margin="6" Padding="10,4" DockPanel.Dock="Right" />
            <Button Content="{Binding Loc[ExamMode]}" Command="{Binding StartExamCommand}"
                    Margin="6" Padding="10,4" DockPanel.Dock="Right"
                    Visibility="{Binding IsTrainingActive, Converter={StaticResource BoolToVis}}" />
            <Button Content="{Binding Loc[DeviceLibrary]}" Command="{Binding BackToLibraryCommand}"
                    Margin="6" Padding="10,4" DockPanel.Dock="Right"
                    Visibility="{Binding IsTrainingActive, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <!-- ───────── 主区域 ───────── -->
        <Grid Grid.Row="1">

            <!-- M9 设备库起始页 -->
            <ScrollViewer Visibility="{Binding IsTrainingActive, Converter={StaticResource BoolToVisInv}}">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding Loc[DeviceLibrary]}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">
                                <Button Width="240" Height="140" Margin="8"
                                        Command="{Binding DataContext.LoadDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 训练界面 -->
            <Grid Visibility="{Binding IsTrainingActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- M3/M4 部件树 -->
                <DockPanel Grid.Column="0" Background="#F4F6F8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[Parts]}" FontWeight="Bold"
                               Margin="10" FontSize="15" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                        <Button Content="{Binding Loc[Isolate]}" Command="{Binding IsolateCommand}" Margin="2" Padding="6,3" />
                        <Button Content="{Binding Loc[ShowAll]}" Command="{Binding ShowAllCommand}" Margin="2" Padding="6,3" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}"
                              BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PartViewModel}">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding IsVisible}" DockPanel.Dock="Right"
                                              ToolTip="显隐 / 表示切替" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <!-- M2 3D 视口 -->
                <Border Grid.Column="1">
                    <hx:Viewport3DX x:Name="View"
                                    EffectsManager="{Binding EffectsManager}"
                                    Camera="{Binding Camera}"
                                    ShowCoordinateSystem="True"
                                    MSAA="Four"
                                    FXAALevel="Medium"
                                    EnableSSAO="True"
                                    SSAOQuality="High"
                                    BackgroundColor="#2B3038">
                        <!-- 三点布光:主光 + 补光 + 轮廓光,提升体积感 -->
                        <hx:AmbientLight3D Color="#33373B" />
                        <hx:DirectionalLight3D Color="#E6E6E6" Direction="-0.6,-1,-0.7" />
                        <hx:DirectionalLight3D Color="#6E7886" Direction="0.8,-0.2,0.6" />
                        <hx:DirectionalLight3D Color="#9AA6B2" Direction="0.2,0.6,-0.9" />
                        <!-- M2:动态加载的模型场景图挂到此分组节点(代码后置 AddNode) -->
                        <hx:SceneNodeGroupModel3D x:Name="GroupModel" />
                        <!-- M3 节点高亮:与 SceneController 的 "highlight" 后效同名 -->
                        <hx:PostEffectMeshBorderHighlight EffectName="highlight" />
                    </hx:Viewport3DX>
                </Border>

                <!-- M6 步骤 + 安全确认面板 -->
                <DockPanel Grid.Column="2" Background="#FAFAFA">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StepTitle}" FontWeight="Bold"
                               FontSize="15" Margin="10,10,10,2" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ProgressText}" Foreground="#607D8B"
                               Margin="10,0,10,8" />

                    <!-- 底部导航按钮 -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                        <Button Content="{Binding Loc[Restart]}" Command="{Binding RestartCommand}" Margin="4" Padding="10,5" />
                        <Button Content="{Binding Loc[Previous]}" Command="{Binding PreviousCommand}" Margin="4" Padding="10,5" />
                        <!-- 安全门:CanExecute 绑 ProcedureRunner.CanAdvance,未勾全则禁用 -->
                        <Button Content="{Binding Loc[Next]}" Command="{Binding NextCommand}" Margin="4" Padding="14,5"
                                FontWeight="Bold" Background="#1976D2" Foreground="White" />
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel Margin="10">
                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                                    Padding="10" Margin="0,0,0,12" CornerRadius="4">
                                <TextBlock Text="{Binding StepInstruction}" TextWrapping="Wrap" FontSize="14" />
                            </Border>

                            <TextBlock Text="{Binding Loc[SafetyChecks]}" FontWeight="Bold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SafetyChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SafetyCheckViewModel}">
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1"
                                                        Background="{Binding Required, Converter={StaticResource ReqBrush}}"
                                                        Visibility="{Binding Required, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DataContext.Loc[Required], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="White" FontSize="11" />
                                                </Border>
                                                <CheckBox IsChecked="{Binding IsConfirmed}" VerticalAlignment="Top" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Loc[GateBlocked]}" Foreground="#D32F2F" TextWrapping="Wrap"
                                       Margin="0,12,0,0" FontSize="12"
                                       Visibility="{Binding CanAdvance, Converter={StaticResource BoolToVisInv}}" />

                            <TextBlock Text="{Binding Loc[AllComplete]}" Foreground="#2E7D32" FontWeight="Bold"
                                       FontSize="18" Margin="0,12,0,0"
                                       Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 工具栏:复位视角(覆盖在视口左上) -->
                <Button Grid.Column="1" Content="{Binding Loc[ResetView]}" Command="{Binding ResetViewCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" />
            </Grid>

            <!-- M10 考核模式(覆盖层) -->
            <Border Background="#F0FFFFFF"
                    Visibility="{Binding IsExamActive, Converter={StaticResource BoolToVis}}">
                <Border Width="560" MaxHeight="640" Background="White" CornerRadius="6"
                        BorderBrush="#BDBDBD" BorderThickness="1" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel DataContext="{Binding Exam}">
                        <DockPanel.Resources>
                            <local:BoolToVisibilityConverter x:Key="BVis" />
                        </DockPanel.Resources>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding DataContext.Loc[ExamMode], RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="18" FontWeight="Bold" Margin="16,12,16,4" />

                        <!-- 关闭按钮(常驻) -->
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="✕"
                                Command="{Binding DataContext.ExitExamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,-28,16,0" Padding="8,2" />

                        <!-- ① 排序阶段 -->
                        <DockPanel Visibility="{Binding IsArranging, Converter={StaticResource BVis}}">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding DataContext.Loc[ExamInstruction], RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="16,0,16,8" TextWrapping="Wrap" Foreground="#555" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16" HorizontalAlignment="Right">
                                <Button Content="{Binding DataContext.Loc[MoveUp], RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding MoveUpCommand}" Margin="3" Padding="8,4" />
                                <Button Content="{Binding DataContext.Loc[MoveDown], RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding MoveDownCommand}" Margin="3" Padding="8,4" />
                                <Button Content="{Binding DataContext.Loc[ExamSubmit], RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding SubmitCommand}" Margin="3" Padding="10,4"
                                        Background="#1976D2" Foreground="White" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="16,0" MinHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExamStepViewModel}">
                                        <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Padding="4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- ② 执行阶段(安全门仍强制) -->
                        <DockPanel Visibility="{Binding IsExecuting, Converter={StaticResource BVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ExecProgress}" Foreground="#607D8B" Margin="16,0,16,4" />
                            <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                                    Padding="10" Margin="16,0,16,10" CornerRadius="4">
                                <TextBlock Text="{Binding ExecInstruction}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16" HorizontalAlignment="Right">
                                <Button Content="{Binding DataContext.Loc[Next], RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding NextExecCommand}" Margin="3" Padding="14,5"
                                        FontWeight="Bold" Background="#1976D2" Foreground="White" />
                            </StackPanel>
                            <ScrollViewer Margin="16,0">
                                <ItemsControl ItemsSource="{Binding SafetyChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SafetyCheckViewModel}">
                                            <DockPanel Margin="0,4">
                                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1" Background="#D32F2F"
                                                        Visibility="{Binding Required, Converter={StaticResource BVis}}">
                                                    <TextBlock Text="{Binding DataContext.Loc[Required], RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Foreground="White" FontSize="11" />
                                                </Border>
                                                <CheckBox IsChecked="{Binding IsConfirmed}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ③ 结果 -->
                        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BVis}}" Margin="16">
                            <TextBlock Text="{Binding DataContext.Loc[AllComplete], RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="16" FontWeight="Bold" Foreground="#2E7D32" />
                            <TextBlock Text="{Binding OrderingSummary}" Margin="0,8,0,0" FontWeight="Bold" Foreground="#1976D2" />
                            <TextBlock Text="{Binding ResultSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#37474F" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ───────── 常驻免责横幅(安全红线) ───────── -->
        <Border Grid.Row="2" Background="#B71C1C">
            <TextBlock Text="{Binding Loc[Disclaimer]}" Foreground="White" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="6" />
        </Border>
    </Grid>
</Window>
