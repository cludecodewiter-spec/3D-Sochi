{
  "equipmentId": "abatement-unit-C",
  "name": { "zh": "除害装置 C 型(柜式)", "ja": "除害装置 C 型(キャビネット式)" },
  "modelFile": "models/unitC.glb",
  "parts": [
    { "id": "cabinet", "node": "cabinet",
      "name": { "zh": "柜体外壳", "ja": "キャビネット筐体" }, "partNo": "C-000" },
    { "id": "control_panel", "node": "control_panel",
      "name": { "zh": "控制面板", "ja": "制御パネル" }, "partNo": "C-001" },
    { "id": "gauge", "node": "gauge",
      "name": { "zh": "压力表", "ja": "圧力計" }, "partNo": "C-002" },
    { "id": "flow_meter", "node": "flow_meter",
      "name": { "zh": "流量计", "ja": "流量計" }, "partNo": "C-003" },
    { "id": "valve", "node": "valve",
      "name": { "zh": "进气阀", "ja": "給気バルブ" }, "partNo": "C-004" },
    { "id": "column", "node": "column",
      "name": { "zh": "立式管柱", "ja": "縦型配管カラム" }, "partNo": "C-005" },
    { "id": "vessel", "node": "vessel",
      "name": { "zh": "不锈钢容器", "ja": "ステンレス容器" }, "partNo": "C-006" }
  ],
  "procedure": {
    "title": { "zh": "柜式装置容器更换", "ja": "キャビネット式装置 容器交換" },
    "steps": [
      {
        "order": 1,
        "action": "highlight",
        "targetPart": "gauge",
        "instruction": { "zh": "确认压力表读数已归零,内部无残压", "ja": "圧力計がゼロを示し、内部に残圧がないことを確認" },
        "safetyChecks": [
          { "type": "LeakCheck", "text": { "zh": "确认压力表归零、无残压", "ja": "圧力計ゼロ・残圧なしを確認" }, "required": true }
        ]
      },
      {
        "order": 2,
        "action": "highlight",
        "targetPart": "valve",
        "instruction": { "zh": "关闭进气阀并上锁挂牌", "ja": "給気バルブを閉じ、施錠・札掛けを行う" },
        "safetyChecks": [
          { "type": "Loto", "text": { "zh": "确认进气阀已关闭、上锁挂牌", "ja": "給気バルブの閉止・施錠・札掛けを確認" }, "required": true },
          { "type": "Ppe",  "text": { "zh": "确认已佩戴防护装备", "ja": "保護具の着用を確認" }, "required": true }
        ]
      },
      {
        "order": 3,
        "action": "remove",
        "targetPart": "column",
        "removeOffset": [0, 0.6, 0],
        "instruction": { "zh": "松开管件法兰,向上抽出立式管柱", "ja": "配管フランジを緩め、縦型カラムを上方へ引き抜く" },
        "safetyChecks": [
          { "type": "Purge",  "text": { "zh": "确认管路已吹扫置换", "ja": "配管のパージ・置換を確認" }, "required": true },
          { "type": "Torque", "text": { "zh": "确认法兰螺栓按规范松开", "ja": "フランジボルトを規定どおり緩めたことを確認" }, "required": true }
        ]
      },
      {
        "order": 4,
        "action": "remove",
        "targetPart": "vessel",
        "removeOffset": [0, 0, 0.6],
        "instruction": { "zh": "确认已排空后,向前取出不锈钢容器", "ja": "排出完了を確認後、ステンレス容器を手前へ取り出す" },
        "safetyChecks": [
          { "type": "LeakCheck", "text": { "zh": "确认容器内已排空、无泄漏", "ja": "容器内の排出完了・漏れなしを確認" }, "required": true },
          { "type": "Ppe",       "text": { "zh": "确认防护装备完好、搬运安全", "ja": "保護具の状態・運搬の安全を確認" }, "required": true }
        ]
      }
    ]
  }
}
