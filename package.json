{
  "name": "jpfetest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基本情報技術者試験（FE）CBT模擬試験システム — IPA公式公開過去問のみを使用",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "node tools/discover.mjs",
    "scan-text": "node tools/scan-text.mjs",
    "probe": "node tools/probe.mjs",
    "build-text": "node tools/build-text.mjs",
    "build-image": "node tools/build-image.mjs",
    "validate": "node tools/validate.mjs",
    "import": "npm run discover && npm run scan-text && npm run build-text && npm run validate",
    "report": "node tools/report.mjs",
    "test": "node --test tools/*.test.mjs && node tools/validate-explanations.mjs",
    "ocr-crops": "node tools/ocr-crops.mjs",
    "validate:explanations": "node tools/validate-explanations.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.33.5"
  }
}
